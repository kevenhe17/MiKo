# BugTrace 生产环境变量模板
# 用法：复制为 .env，修改密码与 JWT 密钥后，执行 docker compose -f docker-compose.prod.yml up -d --build

# ---- 数据库（同时用于 docker-compose 与后端 DATABASE_URL 拼接）----
DB_USER=bugtrace
DB_PASSWORD=ChangeToStrongPassword
DB_NAME=bugtrace
DB_PORT=5432

# ---- 后端 ----
APP_PORT=3000
JWT_SECRET=ChangeToRandomLongStringAtLeast32Chars
