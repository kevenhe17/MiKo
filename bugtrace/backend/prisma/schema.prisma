// BugTrace MVP · Prisma Schema V0.1
// 依据：《MVP 范围定义 V0.1》§2.2 表 2-2 + 《开发计划》P0 T0-2 任务卡
// 状态：仅定义，未执行迁移（等待 G0-1 数据模型评审）
//
// 约定（见任务卡 Constraints）：
//  - 主键 BigInt @id @default(autoincrement())
//  - 每表 created_at / updated_at（updated_at 用 @updatedAt 自动刷新）
//  - 外键字段一律建 @@index
//  - 模型驼峰命名，表名/列名 snake_case 并用 @map
//  - 不添加 deleted_at / version 等 V0.2 字段
//
// 已确认假设（提交 G0-1 评审）：
//  - 枚举严格 3 个（Role / BugStatus / BugSeverity），
//    bug.priority / test_case.priority / requirement.status /
//    test_plan.status / attachment.target_type 用 String 存储，取值在应用层校验
//  - test_case 增加可空 requirement_id（功能点 6「用例关联需求」的落点）
//  - project.members 为 Json 列（MVP 无 project_member 表，成员邀请写入该列）
//  - attachment.target_id 为多态引用（bug/case），不建物理外键，用复合索引覆盖

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= 枚举（3 个） =================

enum Role {
  ADMIN
  DEV
  QA
}

enum BugStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
}

enum BugSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
}

// ================= 表（8 张） =================

// 1. 系统用户。MVP 用全局 role 简化，V0.2 改为 project_member 表
model User {
  id           BigInt   @id @default(autoincrement()) @map("id")
  username     String   @unique @map("username")
  passwordHash String   @map("password_hash")
  realname     String   @map("realname")
  role         Role     @map("role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdProjects Project[] @relation("ProjectCreator")
  ownedBugs       Bug[]     @relation("BugOwner")
  fixedBugs       Bug[]     @relation("BugFixer")
  uploads         Attachment[]
  operations      BugLog[]
  ownedPlans      TestPlan[]

  @@map("user")
}

// 2. 项目。members 为 Json 列：[{ userId, role }]；创建者自动成为 ADMIN
model Project {
  id          BigInt   @id @default(autoincrement()) @map("id")
  code        String   @unique @map("code")
  name        String   @map("name")
  description String?  @map("description")
  createdBy   BigInt   @map("created_by")
  members     Json     @default("[]") @map("members")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator      User           @relation("ProjectCreator", fields: [createdBy], references: [id])
  requirements Requirement[]
  testCases    TestCase[]
  bugs         Bug[]
  attachments  Attachment[]
  testPlans    TestPlan[]

  @@index([createdBy])
  @@map("project")
}

// 3. 需求。只做登记，不做 PRD 解析；status 取值 OPEN/CLOSED（应用层校验）
model Requirement {
  id          BigInt   @id @default(autoincrement()) @map("id")
  projectId   BigInt   @map("project_id")
  code        String   @unique @map("code")
  title       String   @map("title")
  description String?  @map("description")
  status      String   @default("OPEN") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id])
  testCases TestCase[]
  bugs      Bug[]

  @@index([projectId])
  @@map("requirement")
}

// 4. 测试用例。priority 取值 P0/P1/P2（应用层校验）；requirement_id 关联需求（功能点 6）
model TestCase {
  id            BigInt   @id @default(autoincrement()) @map("id")
  projectId     BigInt   @map("project_id")
  module        String   @map("module")
  title         String   @map("title")
  precond       String?  @map("precond")
  steps         String   @map("steps")
  expected      String   @map("expected")
  priority      String?  @map("priority")
  requirementId BigInt?  @map("requirement_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  bugs        Bug[]

  @@index([projectId])
  @@index([requirementId])
  @@index([module])
  @@map("test_case")
}

// 5. Bug 主表。18 个字段（不含 id），含修复说明三件套 root_cause / fix_desc / impact
model Bug {
  id           BigInt      @id @default(autoincrement()) @map("id")
  projectId    BigInt      @map("project_id")
  code         String      @unique @map("code")
  title        String      @map("title")
  severity     BugSeverity @map("severity")
  priority     String?     @map("priority")
  status       BugStatus   @default(NEW) @map("status")
  module       String      @map("module")
  environment  String      @map("environment")
  steps        String      @map("steps")
  expected     String      @map("expected")
  actual       String      @map("actual")
  ownerId      BigInt?     @map("owner_id")
  fixerId      BigInt?     @map("fixer_id")
  rootCause    String?     @map("root_cause")
  fixDesc      String?     @map("fix_desc")
  impact       String?     @map("impact")
  requirementId BigInt?    @map("requirement_id")
  caseId       BigInt?     @map("case_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  case        TestCase?   @relation(fields: [caseId], references: [id])
  owner       User?       @relation("BugOwner", fields: [ownerId], references: [id])
  fixer       User?       @relation("BugFixer", fields: [fixerId], references: [id])
  logs        BugLog[]

  @@index([projectId])
  @@index([ownerId])
  @@index([fixerId])
  @@index([requirementId])
  @@index([caseId])
  @@index([status])
  @@map("bug")
}

// 6. 附件。target_type 取值 bug / case（应用层校验）；target_id 为多态引用，无物理外键
model Attachment {
  id         BigInt   @id @default(autoincrement()) @map("id")
  projectId  BigInt   @map("project_id")
  targetType String   @map("target_type")
  targetId   BigInt   @map("target_id")
  filename   String   @map("filename")
  filepath   String   @map("filepath")
  size       Int      @map("size")
  uploadedBy BigInt   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([uploadedBy])
  @@index([targetType, targetId])
  @@map("attachment")
}

// 7. Bug 操作流水。每次状态变更追加一条，只增不改不删
model BugLog {
  id         BigInt    @id @default(autoincrement()) @map("id")
  bugId      BigInt    @map("bug_id")
  operatorId BigInt    @map("operator_id")
  action     String    @map("action")
  fromStatus BugStatus @map("from_status")
  toStatus   BugStatus @map("to_status")
  comment    String?   @map("comment")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  bug      Bug  @relation(fields: [bugId], references: [id])
  operator User @relation(fields: [operatorId], references: [id])

  @@index([bugId])
  @@index([operatorId])
  @@map("bug_log")
}

// 8. 测试计划。case_ids 用 Json 数组存用例 id，不建关联表（V0.2 迁移为 test_plan_case）
model TestPlan {
  id        BigInt   @id @default(autoincrement()) @map("id")
  projectId BigInt   @map("project_id")
  name      String   @map("name")
  ownerId   BigInt   @map("owner_id")
  caseIds   Json     @default("[]") @map("case_ids")
  status    String   @default("READY") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])

  @@index([projectId])
  @@index([ownerId])
  @@map("test_plan")
}
